# ─────────────────────────────────────────────
#  Backend — required
# ─────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter models (active free tier — verified 2026-08-21)
ROUTER_MODEL=google/gemma-4-26b-a4b-it:free
ROUTER_MODEL_ALT=nvidia/nemotron-3-nano-30b-a3b:free
GENERATOR_MODEL=google/gemma-4-31b-it:free
EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free

# How often (in turns) to refresh the global summary
SUMMARIZER_EVERY_N_TURNS=5

# ─────────────────────────────────────────────
#  Database (optional for MVP — uses in-memory by default)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/semantic_graph
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────
#  Frontend
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/chat
